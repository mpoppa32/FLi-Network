{
  "rules": {
    "users": {
      "$uid": {
        ".read":  "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "workspaces": {
      "$wsId": {
        ".read": "auth != null && root.child('workspaces').child($wsId).child('members').child(auth.uid).exists()",

        "info": {
          ".read":  "auth != null",
          ".write": "auth != null && (!data.exists() || root.child('workspaces').child($wsId).child('members').child(auth.uid).exists())"
        },

        "members": {
          ".read":  "auth != null && root.child('workspaces').child($wsId).child('members').child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('workspaces').child($wsId).child('members').child(auth.uid).child('role').val() === 'admin' || root.child('workspaces').child($wsId).child('members').child(auth.uid).child('role').val() === 'Admin' || root.child('workspaces').child($wsId).child('members').child(auth.uid).child('role').val() === 'Owner')"
          }
        },

        "settings": {
          ".read":  "auth != null && root.child('workspaces').child($wsId).child('members').child(auth.uid).exists()",
          ".write": "auth != null && (root.child('workspaces').child($wsId).child('members').child(auth.uid).child('role').val() === 'admin' || root.child('workspaces').child($wsId).child('members').child(auth.uid).child('role').val() === 'Admin' || root.child('workspaces').child($wsId).child('members').child(auth.uid).child('role').val() === 'Owner')"

          ".write": "auth != null && root.child('workspaces').child($wsId).child('members').child(auth.uid).exists() && root.child('workspaces').child($wsId).child('members').child(auth.uid).child('role').val() !== 'observer' && root.child('workspaces').child($wsId).child('members').child(auth.uid).child('role').val() !== 'Observer'"
        }
      }
    },

    "invites": {
      "$wsId": {
        "$email": {
          ".write": "auth != null && root.child('workspaces').child($wsId).child('members').child(auth.uid).exists()"
        }

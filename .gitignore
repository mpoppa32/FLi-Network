# Atlas master-sheet sync — internal operator business config (private Google
# Sheet IDs, customer names, deal logic). Kept OUT of this PUBLIC repo. The
# source lives on the operator's local checkout + in production; index.ts
# references it, so build/deploy from a checkout that has these files.
functions/src/sources/atlasMaster/
functions/src/jobs/atlasMasterSync.ts
functions/src/http/triggerAtlasMasterSync.ts
functions/src/http/triggerAtlasMasterRead.ts

# Credentials materialized by google-github-actions/auth in CI. Never committed.
gha-creds-*.json

# Sweep manifests — the output of scripts/sweep-manifest.mjs. NEVER COMMITTED.
# They carry verbatim action-item text, owner names and customer meeting titles
# read straight out of live Atlas, and this repo is PUBLIC. The script writes
# here by default and the generator is the only thing that should; if you point
# it somewhere else with --out, point it somewhere else that is ignored too.
sweep-manifests/
